{
  "regions": ["sin1"],
  "functions": {
    "api/index.js": { "includeFiles": "shops/**" },
    "api/cron.js": { "includeFiles": "shops/**", "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cron", "schedule": "0 1 * * *" }
  ],
  "trailingSlash": false,
  "rewrites": [
    { "source": "/staff", "destination": "/staff.html" },
    { "source": "/:shop([a-z0-9-]+)/staff", "destination": "/staff.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/:shop([a-z0-9-]+)/admin", "destination": "/admin.html" },
    { "source": "/:shop([a-z0-9-]+)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
